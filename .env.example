# Server-only. Copy to .env.local and replace the placeholder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set to false to fail after invalid question output instead of using fixed fallback questions.
ALLOW_FALLBACK=true

# csv for local files; supabase after applying supabase/migrations/*.sql.
RESULT_STORAGE=csv
# Server-only. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
